# Salin jadi .env untuk dev lokal, isi dengan nilai sungguhan dari Supabase
# Dashboard (Project Settings -> API & Database). Untuk deploy Vercel,
# daftarkan variabel yang sama di Project Settings -> Environment Variables
# — file .env ini tidak ikut ter-deploy.

# Connection pooler Supabase (Supavisor). ?pgbouncer=true WAJIB di
# DATABASE_URL (dipakai Prisma Client saat runtime); DIRECT_URL (tanpa
# pgbouncer) dipakai migrasi. connection_limit=5 mencegah exhaust pooler
# saat beberapa halaman menjalankan Promise.all query sekaligus.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth. Publishable/anon key aman di browser; secret key HANYA
# server-side (dipakai src/lib/supabase/admin.ts untuk hapus akun).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="..."

# Menolak permintaan ke /api/cron/health-snapshot selain dari Vercel Cron
# (header Authorization: Bearer <CRON_SECRET>). Beda nilai per lingkungan
# (dev/preview/production) — jangan pakai ulang nilai production di lokal.
CRON_SECRET="..."

# Opsional — menunda penandaan DORMANT otomatis tanpa membekukan snapshot
# harian (dipakai saat latihan demo/masa penjurian, lihat
# api/cron/health-snapshot/route.ts). Tanggal ISO, mis. "2026-09-21".
# DORMANT_FREEZE_UNTIL=

# Opsional — HANYA diisi di Vercel Production, JANGAN di dev lokal/CI.
# Memasang app di sub-path domain landing page (usetether.web.id/test)
# sementara sebelum keputusan domain final — lihat RENCANA-BESAR.md H0.2.
# Kalau diisi, vercel.json cron path juga HARUS ikut diberi prefix yang sama.
# NEXT_BASE_PATH=/test

# Opsional — menimpa ambang rate limit default (src/lib/rate-limit.ts).
# Longgarkan HANYA di dev lokal / Vercel Preview, jangan di Production.
# RATE_LIMIT_SIGN_IN=5
# RATE_LIMIT_SIGN_UP=3
# RATE_LIMIT_RESET_PASSWORD=3
# RATE_LIMIT_INVITE=30
# RATE_LIMIT_APPLY=30
# RATE_LIMIT_PEER_RATING=40
